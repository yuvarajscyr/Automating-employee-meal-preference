/**
 * E2E DAILY MEAL LIST AUTOMATION
 * ================================
 * Reads tomorrow's Breakfast / Lunch / Dinner Y/N marks from the food sheet
 * and sends the formatted list to your WhatsApp group(s) via Green API.
 * (A backup email is still sent if the WhatsApp send fails.)
 * Skips entirely on any date listed in SKIP_DATES (holidays, no canteen).
 */

// ---------- CONFIG ----------
var SPREADSHEET_ID = '1BM4VOsMs2FYWf7dCYCm0RQ-942XoEYMEke_WZH9jc0A';
var SHEET_GID = 1753694936;          // from the sheet URL (#gid=...)
var EMAIL_TO = 's.yuvaraj@e2enetworks.com'; // fallback only

var GREEN_API_ID_INSTANCE = '710722761902';
var GREEN_API_TOKEN = '';
var WHATSAPP_GROUP_CHAT_IDS = [
  '120363424258597876@g.us',
  '919585190687@c.us',
];

// Dates (tomorrow's date) to skip entirely — no message sent at all.
// Format: 'YYYY-MM-DD'. Add one line per holiday, in advance.
var SKIP_DATES = [
  '2026-11-07' // diwali— no canteen
];
// -----------------------------

function generateMealList() {
  var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  var sheet = getSheetByGid_(ss, SHEET_GID);
  var data = sheet.getDataRange().getDisplayValues();

  var tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);

  // --- NEW: skip entirely if tomorrow is a listed holiday ---
  var tomorrowKey = Utilities.formatDate(tomorrow, Session.getScriptTimeZone(), 'yyyy-MM-dd');
  if (SKIP_DATES.indexOf(tomorrowKey) !== -1) {
    return; // no WhatsApp message, no email — script does nothing today
  }
  // -----------------------------------------------------------

  var targetDay = tomorrow.getDate();
  var targetMonth = tomorrow.getMonth() + 1; // 1-12
  var targetYear = tomorrow.getFullYear();

  var names = { BF: [], L: [], D: [] };

  var colMap = null; // {colIndex: {day, meal}}
  for (var i = 0; i < data.length; i++) {
    var row = data[i];

    // A new "Employee No" row marks the header for the block below it.
    if (row[0] === 'Employee No') {
      var header1 = data[i - 1] || [];
      var header2 = row;
      colMap = buildColMap_(header1, header2);
      continue;
    }

    // Regular employee data row, e.g. "E2E124"
    if (/^E2E\d+/i.test(row[0])) {
      var month = parseInt(row[2], 10);
      var year = parseInt(row[3], 10);
      if (month !== targetMonth || year !== targetYear) continue;
      if (!colMap) continue;

      var empName = row[1];
      for (var c in colMap) {
        var info = colMap[c];
        if (info.day !== targetDay) continue;
        var val = (row[c] || '').trim().toUpperCase();
        if (val === 'Y') {
          names[info.meal].push(empName);
        }
      }
      continue;
    }

    // Vendor/Visitor row: the cell itself holds one or more names
    // (comma or newline separated) instead of a Y/N flag against a
    // single Employee Names column. The label lives in column B
    // (Employee Names), not column A (Employee No), which may be blank.
    if (isVendorRow_(row[1])) {
      var vMonth = parseInt(row[2], 10);
      var vYear = parseInt(row[3], 10);
      var vendorMonthYearGiven = !isNaN(vMonth) && !isNaN(vYear);
      if (vendorMonthYearGiven && (vMonth !== targetMonth || vYear !== targetYear)) continue;
      if (!colMap) continue;

      for (var vc in colMap) {
        var vInfo = colMap[vc];
        if (vInfo.day !== targetDay) continue;
        var cellText = (row[vc] || '').trim();
        if (!cellText) continue;
        var extraNames = parseNameList_(cellText);
        extraNames.forEach(function(n) { names[vInfo.meal].push(n); });
      }
    }
  }

  var dateStr = formatOrdinalDate_(tomorrow);
  var body = buildMessage_(dateStr, names);

  sendMealListToWhatsapp(body);
}

// Build a column -> {day, meal} map by forward-filling merged header cells.
function buildColMap_(header1, header2) {
  var map = {};
  var lastLabel = '';
  var lastDay = null;
  var width = Math.max(header1.length, header2.length);
  for (var c = 4; c < width; c++) { // columns E onward (0-indexed 4)
    var l1 = (header1[c] || '').trim();
    if (l1 !== '') lastLabel = l1;

    var l2 = (header2[c] || '').trim();
    if (l2 !== '') lastDay = l2;

    if (lastLabel === 'BF' || lastLabel === 'L' || lastLabel === 'D') {
      var dayNum = parseInt(String(lastDay).replace(/[^\d]/g, ''), 10);
      if (!isNaN(dayNum)) {
        map[c] = { day: dayNum, meal: lastLabel };
      }
    }
  }
  return map;
}

function getSheetByGid_(ss, gid) {
  var sheets = ss.getSheets();
  for (var i = 0; i < sheets.length; i++) {
    if (sheets[i].getSheetId() === gid) return sheets[i];
  }
  throw new Error('Sheet with gid ' + gid + ' not found');
}

