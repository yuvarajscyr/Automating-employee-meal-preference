  Logger.log('isVendorRow_(B39) = ' + isVendorRow_(row39[1]));

  var header1 = sheet.getRange(sheet.getLastRow() > 0 ? findHeaderRowAbove_(sheet, 39) - 1 : 1, 1, 1, lastCol).getDisplayValues()[0];
  var header2 = sheet.getRange(findHeaderRowAbove_(sheet, 39), 1, 1, lastCol).getDisplayValues()[0];
  var colMap = buildColMap_(header1, header2);

