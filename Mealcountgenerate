function findHeaderRowAbove_(sheet, fromRow) {
  var colA = sheet.getRange(1, 1, fromRow, 1).getDisplayValues();
  for (var k = fromRow - 1; k >= 1; k--) {
    if (colA[k - 1][0] === 'Employee No') return k;
  }
  return 1;
}

function isVendorRow_(label) {
  return String(label || '').trim().toLowerCase() === 'e2e vendor/visitor';
}

function parseNameList_(text) {
  return text
    .split(/[,\n]/)
    .map(function(n) { return n.trim(); })
    .filter(function(n) { return n.length > 0; });
}

function formatOrdinalDate_(date) {
  var day = date.getDate();
  var suffix = 'th';
  if (day % 10 === 1 && day !== 11) suffix = 'st';
  else if (day % 10 === 2 && day !== 12) suffix = 'nd';
  else if (day % 10 === 3 && day !== 13) suffix = 'rd';
  var months = ['January','February','March','April','May','June','July',
                'August','September','October','November','December'];
  return day + suffix + ' ' + months[date.getMonth()] + ' ' + date.getFullYear();
}

function buildMessage_(dateStr, names) {
  var lines = ['Meal count for E2E', ''];

  lines.push('Breakfast');
  lines.push(dateStr);
  lines = lines.concat(mealBlock_(names.BF));
  lines.push('');

  lines.push('Lunch');
  lines.push(dateStr);
  lines = lines.concat(mealBlock_(names.L));
  lines.push('');

  lines.push('Dinner');
  lines.push(dateStr);
  lines = lines.concat(mealBlock_(names.D));

  return lines.join('\n');
}

function mealBlock_(list) {
  if (list.length === 0) return ['Nil'];
  return [list.length + ' Qty', list.join(', ') + '.'];
}

// ---------- WhatsApp send via Green API ----------
function sendMealListToWhatsapp(message) {
  var failures = [];

  WHATSAPP_GROUP_CHAT_IDS.forEach(function(chatId) {
    var url = 'https://7107.api.green-api.com/waInstance' + GREEN_API_ID_INSTANCE +
              '/sendMessage/' + GREEN_API_TOKEN;

    var payload = {
      chatId: chatId,
      message: message
    };

    var options = {
      method: 'post',
      contentType: 'application/json',
      payload: JSON.stringify(payload),
      muteHttpExceptions: true
    };

    var response = UrlFetchApp.fetch(url, options);
    var code = response.getResponseCode();

    if (code !== 200) {
      failures.push(chatId + ' -> ' + code + ': ' + response.getContentText());
    }
  });

  if (failures.length > 0) {
    MailApp.sendEmail({
      to: EMAIL_TO,
      subject: 'WhatsApp send FAILED for ' + failures.length + ' group(s) — meal list',
      body: 'Failures:\n' + failures.join('\n\n') +
            '\n\n--- Message that failed to send ---\n' + message
    });
  }
}

